<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.deepon</groupId>
  <artifactId>smartdocs-parent</artifactId>
  <version>0.3.0-stage3</version>
  <packaging>pom</packaging>
  <name>smartdocs-parent</name>
  <description>Stage 3: conflict-free concurrent editing</description>

  <!--
    Two modules, and the split is the point: crdt-core is the merge algorithm
    with no Spring, no IO and no framework of any kind on its classpath, so
    "the CRDT does not depend on the server" is enforced by the build rather
    than by a convention anyone can break (Stage 3 design doc section 6).
  -->
  <modules>
    <module>crdt-core</module>
    <module>smartdocs-app</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <testcontainers.version>1.21.4</testcontainers.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            A goal invoked from the command line runs against every project in
            the reactor, and neither this aggregator nor crdt-core has a main
            class to run or repackage. Skipping here is what lets
            `mvn -pl smartdocs-app -am spring-boot:run` work as one command,
            so crdt-core is always rebuilt from source rather than resolved
            stale out of ~/.m2. smartdocs-app turns it back on.
          -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
